# 複製為 .env 後填入。.env 不可進版控。

# SQL Server sa 密碼：至少 8 碼，需含大小寫、數字、符號中的三種
DB_SA_PASSWORD=

# JWT 簽章金鑰：至少 32 個隨機字元
# 產生方式（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_KEY=

# 第一個管理員帳號（僅在資料庫沒有任何帳號時建立；登入後請立即修改密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 對外埠號
APP_PORT=8080

# 前面有 Nginx / Caddy 等反向代理時設為 true
BEHIND_PROXY=false

TIME_ZONE=Asia/Taipei
