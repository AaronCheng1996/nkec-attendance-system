# 複製為 .env 後填入。.env 不可進版控。

# 要執行的 image（Docker Hub 帳號/名稱:標籤）。latest 為 main 分支最新版；
# 也可以固定在某個版本，例如 :1.2.0，或某次 commit，例如 :sha-abc1234
APP_IMAGE=<dockerhub-帳號>/nkec-attendance-system:latest

# SQL Server sa 密碼：至少 8 碼，需含大小寫、數字、符號中的三種
DB_SA_PASSWORD=

# JWT 簽章金鑰：至少 32 個隨機字元
# 產生方式（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_KEY=

# 第一個管理員帳號（僅在資料庫沒有任何帳號時建立；登入後請立即修改密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 對外埠號
APP_PORT=8080

# 前面有反向代理時設為 127.0.0.1，只讓本機的代理連得到 app
APP_BIND=0.0.0.0

# SQL Server 最多使用的記憶體（MB）。和其他服務共用主機時可調低，Express 版最低建議 1536
DB_MEMORY_LIMIT_MB=2048

# 前面有 Nginx / Caddy 等反向代理時設為 true
BEHIND_PROXY=false

TIME_ZONE=Asia/Taipei
